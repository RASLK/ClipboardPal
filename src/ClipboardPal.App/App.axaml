<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ClipboardPal"
             x:Class="ClipboardPal.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ClipboardPal/Themes/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:ImagePathToBitmapConverter x:Key="ImageThumb" />
      <local:RelativeTimeConverter x:Key="RelativeTime" />
      <local:SlotVisibleConverter x:Key="SlotVisible" />
      <local:EnumMatchConverter x:Key="EnumMatch" />
      <local:EnumIntConverter x:Key="EnumInt" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />

    <!-- The switch itself already shows the state — drop Fluent's default "On"/"Off" labels -->
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
    </Style>

    <!-- Clip cards: theme-aware hover/selection instead of hardcoded colors -->
    <Style Selector="Border.clip-card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.clip-card:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
    </Style>
    <Style Selector="Border.clip-card.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Card action buttons: subtle until the card is hovered -->
    <Style Selector="Border.clip-card StackPanel.card-actions">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.clip-card:pointerover StackPanel.card-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- OCR button on image cards: dim until it has read something, then lit like a badge -->
    <Style Selector="Button.ocr-badge">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ocr-badge:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ocr-badge:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Recognized: fully lit, accent-filled -->
    <Style Selector="Button.ocr-badge.done">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.ocr-badge.done /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.ocr-badge.running">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ocr-badge.running /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Button.ocr-badge.failed">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.ocr-badge.failed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- Space switcher: quiet segments on a recessed track, the active one lifted with accent -->
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.seg /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.seg.active">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.seg.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Little count badge inside the queue segment -->
    <Style Selector="Border.count-pill">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.count-pill TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Card queue toggle: lights up while the clip is staged in the queue -->
    <Style Selector="Button.queue-toggle.queued">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.queue-toggle.queued /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <!-- Search field: accent ring while focused -->
    <Style Selector="Border#SearchBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SearchBorder:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Margin" Value="2,0,0,2" />
    </Style>
    <Style Selector="TextBlock.row-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.row-hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,12,0" />
    </Style>
    <Style Selector="Border.section-card">
      <Setter Property="Background" Value="{DynamicResource SectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.section-card ToggleSwitch">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border.section-card ComboBox">
      <Setter Property="MinWidth" Value="180" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.section-card Slider">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFD13438" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TabControl > TabItem">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/tray.png"
                ToolTipText="ClipboardPal"
                IsVisible="True"
                Clicked="Tray_Clicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open panel" local:App.MenuKey="tray.open" Click="TrayOpen_Click" />
            <NativeMenuItem Header="Settings" local:App.MenuKey="tray.settings" Click="TraySettings_Click" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Clear history" local:App.MenuKey="tray.clear" Click="TrayClear_Click" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit" local:App.MenuKey="tray.exit" Click="TrayExit_Click" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
