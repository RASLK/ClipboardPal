<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipboardPal.RegionPickerWindow"
        Title="ClipboardPal"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        KeyDown="Window_KeyDown">

  <Border Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1" CornerRadius="14" Padding="14">
    <DockPanel LastChildFill="True">

      <TextBlock x:Name="HintText" DockPanel.Dock="Top"
                 Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                 HorizontalAlignment="Center" Margin="0,0,0,10" />

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click"
                  Padding="12,6" MinWidth="38" />
          <TextBlock x:Name="ZoomText" VerticalAlignment="Center" FontSize="12" MinWidth="48"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click"
                  Padding="12,6" MinWidth="38" />
          <Button x:Name="FitButton" Click="Fit_Click" Padding="12,6" />
        </StackPanel>

        <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center"
                   HorizontalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="WholeButton" Click="Whole_Click" Padding="12,6" />
          <Button x:Name="CancelButton" Click="Cancel_Click" Padding="12,6" />
          <Button x:Name="AcceptButton" Click="Accept_Click" Padding="12,6" IsEnabled="False" />
        </StackPanel>
      </Grid>

      <!-- Viewport: the image is positioned by hand so zoom and pan stay in image pixels -->
      <Border x:Name="Viewport" CornerRadius="8" ClipToBounds="True"
              Background="{DynamicResource FieldBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Canvas x:Name="Surface"
                Background="Transparent"
                PointerPressed="Surface_PointerPressed"
                PointerMoved="Surface_PointerMoved"
                PointerReleased="Surface_PointerReleased"
                PointerWheelChanged="Surface_PointerWheelChanged">
          <Image x:Name="Preview" />
          <Rectangle x:Name="Marquee"
                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                     Fill="#224C8DFF" IsVisible="False" />
        </Canvas>
      </Border>

    </DockPanel>
  </Border>
</Window>
