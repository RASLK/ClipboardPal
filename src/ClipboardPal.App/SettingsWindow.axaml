<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipboardPal.Core.ViewModels"
        xmlns:m="using:ClipboardPal.Core.Models"
        x:Class="ClipboardPal.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Loc[settings.window]}"
        Width="720" Height="680"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[settings.title]}" FontSize="20" FontWeight="SemiBold"
               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel Spacing="10" MaxWidth="640">

        <!-- Language -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.language]}" />
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <TextBlock Classes="row-title" Text="{Binding Loc[row.language]}" />
            <TextBlock Classes="row-hint" Text="{Binding Loc[hint.language]}" />
            <ComboBox SelectedIndex="{Binding Settings.Language, Converter={StaticResource EnumInt}, ConverterParameter=UiLanguage}">
              <ComboBoxItem Content="English" />
              <ComboBoxItem Content="Русский" />
              <ComboBoxItem Content="Deutsch" />
              <ComboBoxItem Content="Français" />
              <ComboBoxItem Content="中文" />
              <ComboBoxItem Content="日本語" />
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- Enable -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.enable]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.monitor]}" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.monitor]}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ClipboardMonitoringEnabled}" />
          </Grid>
        </Border>

        <!-- General -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.general]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.autostart]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.LaunchAtLogin}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.topmost]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.KeepWindowOnTop}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.tray]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowTrayIcon}" />
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.dock]}" />
              <WrapPanel>
                <RadioButton GroupName="Dock" Margin="0,0,12,4" Padding="8,6"
                             ToolTip.Tip="{Binding Loc[dock.left]}"
                             IsChecked="{Binding Settings.PanelDock, Converter={StaticResource EnumMatch}, ConverterParameter=Left}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="18" Height="18">
                      <Canvas Width="16" Height="16">
                        <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Fill="Transparent"
                              Data="M2,2 H14 V14 H2 Z" />
                        <Path Fill="{DynamicResource AccentBrush}" Data="M2,2 H5.2 V14 H2 Z" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Loc[dock.left]}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Dock" Margin="0,0,12,4" Padding="8,6"
                             ToolTip.Tip="{Binding Loc[dock.right]}"
                             IsChecked="{Binding Settings.PanelDock, Converter={StaticResource EnumMatch}, ConverterParameter=Right}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="18" Height="18">
                      <Canvas Width="16" Height="16">
                        <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Fill="Transparent"
                              Data="M2,2 H14 V14 H2 Z" />
                        <Path Fill="{DynamicResource AccentBrush}" Data="M10.8,2 H14 V14 H10.8 Z" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Loc[dock.right]}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Dock" Margin="0,0,12,4" Padding="8,6"
                             ToolTip.Tip="{Binding Loc[dock.top]}"
                             IsChecked="{Binding Settings.PanelDock, Converter={StaticResource EnumMatch}, ConverterParameter=Top}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="18" Height="18">
                      <Canvas Width="16" Height="16">
                        <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Fill="Transparent"
                              Data="M2,2 H14 V14 H2 Z" />
                        <Path Fill="{DynamicResource AccentBrush}" Data="M2,2 H14 V5.2 H2 Z" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Loc[dock.top]}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Dock" Margin="0,0,12,4" Padding="8,6"
                             ToolTip.Tip="{Binding Loc[dock.bottom]}"
                             IsChecked="{Binding Settings.PanelDock, Converter={StaticResource EnumMatch}, ConverterParameter=Bottom}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="18" Height="18">
                      <Canvas Width="16" Height="16">
                        <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Fill="Transparent"
                              Data="M2,2 H14 V14 H2 Z" />
                        <Path Fill="{DynamicResource AccentBrush}" Data="M2,10.8 H14 V14 H2 Z" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Loc[dock.bottom]}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
              </WrapPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.confirm.quit]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ConfirmBeforeQuit}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.hide.outside]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.HidePopupOnOutsideClick}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.updates]}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="accent" Content="{Binding Loc[btn.install]}"
                      Command="{Binding InstallUpdateCommand}"
                      IsVisible="{Binding UpdateAvailable}"
                      Padding="12,6" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="{Binding Loc[btn.check]}" Command="{Binding CheckUpdatesCommand}"
                      Padding="12,6" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                         Text="{Binding UpdateStatus}" Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                         IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.hotkey]}" />
              <TextBox x:Name="HotkeyBox"
                       Text="{Binding HotkeyDisplay}" IsReadOnly="True"
                       Focusable="True"
                       MinWidth="180" MaxWidth="320" HorizontalAlignment="Stretch"
                       GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.hotkey]}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Copy & Paste -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.copypaste]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.sound]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.PlaySoundOnCopy}" />
            </Grid>
            <StackPanel IsVisible="{Binding Settings.PlaySoundOnCopy}" Spacing="6">
              <TextBlock Classes="row-hint" Text="{Binding Loc[row.sound.kind]}" />
              <ComboBox SelectedIndex="{Binding Settings.CopySound, Converter={StaticResource EnumInt}, ConverterParameter=CopySoundKind}">
                <ComboBoxItem Content="{Binding Loc[sound.default]}" />
                <ComboBoxItem Content="{Binding Loc[sound.soft]}" />
                <ComboBoxItem Content="{Binding Loc[sound.click]}" />
                <ComboBoxItem Content="{Binding Loc[sound.pop]}" />
              </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.tray.anim]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AnimateTrayOnCopy}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.hide.after.copy]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.HidePopupAfterCopy}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.hide.after.paste]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.HidePopupAfterPaste}" />
            </Grid>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.doubleclick]}" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.DoubleClickEnabled}" />
              </Grid>
              <ComboBox IsEnabled="{Binding Settings.DoubleClickEnabled}"
                        SelectedIndex="{Binding Settings.DoubleClickAction, Converter={StaticResource EnumInt}, ConverterParameter=ClipAction}">
                <ComboBoxItem Content="{Binding Loc[action.copy]}" />
                <ComboBoxItem Content="{Binding Loc[action.copy.plain]}" />
                <ComboBoxItem Content="{Binding Loc[action.paste]}" />
                <ComboBoxItem Content="{Binding Loc[action.paste.plain]}" />
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.quickslots]}" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.QuickSlotsEnabled}" />
              </Grid>
              <ComboBox IsEnabled="{Binding Settings.QuickSlotsEnabled}"
                        SelectedIndex="{Binding Settings.QuickSlotAction, Converter={StaticResource EnumInt}, ConverterParameter=ClipAction}">
                <ComboBoxItem Content="{Binding Loc[action.copy]}" />
                <ComboBoxItem Content="{Binding Loc[action.copy.plain]}" />
                <ComboBoxItem Content="{Binding Loc[action.paste]}" />
                <ComboBoxItem Content="{Binding Loc[action.paste.plain]}" />
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Appearance -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.appearance]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.theme]}" />
              <WrapPanel>
                <RadioButton Content="{Binding Loc[theme.dark]}" GroupName="Theme" Margin="0,0,12,4"
                             IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                <RadioButton Content="{Binding Loc[theme.light]}" GroupName="Theme" Margin="0,0,12,4"
                             IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                <RadioButton Content="{Binding Loc[theme.system]}" GroupName="Theme" Margin="0,0,12,4"
                             IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
              </WrapPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.select.last]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.select.last]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SelectLastOnOpen}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.move.recent]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.move.recent]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.MoveRecentToTop}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.card.menu]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.card.menu]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowClipMenuButtons}" />
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.page.size]}" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Minimum="20" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.MainWindowPageSize}" />
                <TextBlock Grid.Column="1" Text="{Binding Settings.MainWindowPageSize}"
                           VerticalAlignment="Center" MinWidth="40" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.popup.limit]}" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Minimum="20" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.PopupItemLimit}" />
                <TextBlock Grid.Column="1" Text="{Binding Settings.PopupItemLimit}"
                           VerticalAlignment="Center" MinWidth="40" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.preview.len]}" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Minimum="20" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.PreviewLength}" />
                <TextBlock Grid.Column="1" Text="{Binding Settings.PreviewLength}"
                           VerticalAlignment="Center" MinWidth="40" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Hot edge -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.hotedge]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.hotedge]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.hotedge]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.HotEdgeEnabled}" />
            </Grid>
            <StackPanel Spacing="8" IsEnabled="{Binding Settings.HotEdgeEnabled}">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.hotedge.corner]}" />
              <UniformGrid Columns="2" Width="96" HorizontalAlignment="Left">
                <RadioButton GroupName="HotCorner" Margin="2" Padding="6"
                             HorizontalContentAlignment="Center"
                             ToolTip.Tip="Top-left"
                             IsChecked="{Binding Settings.HotEdgeCorner, Converter={StaticResource EnumMatch}, ConverterParameter=TopLeft}">
                  <Viewbox Width="22" Height="22">
                    <Canvas Width="16" Height="16">
                      <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="2.2"
                            StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                            Data="M3,11 V3 H11" />
                    </Canvas>
                  </Viewbox>
                </RadioButton>
                <RadioButton GroupName="HotCorner" Margin="2" Padding="6"
                             HorizontalContentAlignment="Center"
                             ToolTip.Tip="Top-right"
                             IsChecked="{Binding Settings.HotEdgeCorner, Converter={StaticResource EnumMatch}, ConverterParameter=TopRight}">
                  <Viewbox Width="22" Height="22">
                    <Canvas Width="16" Height="16">
                      <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="2.2"
                            StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                            Data="M13,11 V3 H5" />
                    </Canvas>
                  </Viewbox>
                </RadioButton>
                <RadioButton GroupName="HotCorner" Margin="2" Padding="6"
                             HorizontalContentAlignment="Center"
                             ToolTip.Tip="Bottom-left"
                             IsChecked="{Binding Settings.HotEdgeCorner, Converter={StaticResource EnumMatch}, ConverterParameter=BottomLeft}">
                  <Viewbox Width="22" Height="22">
                    <Canvas Width="16" Height="16">
                      <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="2.2"
                            StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                            Data="M3,5 V13 H11" />
                    </Canvas>
                  </Viewbox>
                </RadioButton>
                <RadioButton GroupName="HotCorner" Margin="2" Padding="6"
                             HorizontalContentAlignment="Center"
                             ToolTip.Tip="Bottom-right"
                             IsChecked="{Binding Settings.HotEdgeCorner, Converter={StaticResource EnumMatch}, ConverterParameter=BottomRight}">
                  <Viewbox Width="22" Height="22">
                    <Canvas Width="16" Height="16">
                      <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="2.2"
                            StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                            Data="M13,5 V13 H5" />
                    </Canvas>
                  </Viewbox>
                </RadioButton>
              </UniformGrid>
              <TextBlock Classes="row-title" Text="{Binding Loc[row.hotedge.delay]}" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Minimum="0.05" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.HotEdgeDelaySeconds}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Settings.HotEdgeDelaySeconds, StringFormat='{}{0:0.##}'}"
                           VerticalAlignment="Center" MinWidth="40" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Quick mode -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.quickmode]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.quickmode]}" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.quickmode]}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding Settings.QuickModeEnabled}" />
          </Grid>
        </Border>

        <!-- Queue -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.queue]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <TextBlock Classes="row-hint" Text="{Binding Loc[hint.queue]}" Margin="0,0,0,0" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.queue.autoremove]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.queue.autoremove]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.QueueRemoveAfterPaste}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Plain text -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.plaintext]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.autoplain]}" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.autoplain]}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoPlainText}" />
          </Grid>
        </Border>

        <!-- Data -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.data]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.skip.trash]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.skip.trash]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SkipTrash}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.duplicates]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SaveDuplicates}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.images]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.CaptureImages}" />
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.history.limit]}" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Minimum="50" Maximum="100000" TickFrequency="50" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.MaxHistoryItems}" />
                <TextBlock Grid.Column="1" Text="{Binding Settings.MaxHistoryItems}"
                           VerticalAlignment="Center" MinWidth="56" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.exclude]}" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.exclude]}" />
              <Button x:Name="ExcludePickButton"
                      Content="{Binding Loc[btn.exclude.pick]}"
                      HorizontalAlignment="Left" Padding="12,6" Margin="0,2,0,4">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <Border Padding="12" MinWidth="260" MaxWidth="340">
                      <StackPanel Spacing="8">
                        <ScrollViewer MaxHeight="220" IsVisible="{Binding HasSourceAppChoices}">
                          <ItemsControl ItemsSource="{Binding SourceAppChoices}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                          Margin="0,2" HorizontalAlignment="Stretch" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding Loc[exclude.empty]}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding !HasSourceAppChoices}" />
                        <Button Content="{Binding Loc[btn.exclude.pick.done]}"
                                HorizontalAlignment="Right" Padding="14,6"
                                Classes="accent" Click="ExcludePickDone_Click"
                                IsVisible="{Binding HasSourceAppChoices}" />
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                       Text="{Binding Settings.ExcludedApps}" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[row.exclude.hide]}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,8,0" />
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding Settings.HideExcludedAppHistory}" />
              </Grid>
              <TextBlock Text="{Binding Loc[hint.exclude.hide]}"
                         FontSize="11.5" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Links -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.link]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.link.preview]}" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.link.preview]}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.FetchLinkPreview}" />
          </Grid>
        </Border>

        <!-- Search -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.search]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.case]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.case]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SearchCaseSensitive}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.regex]}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.SearchUseRegex}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- History -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.history]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.retention]}" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.retention]}" />
              <ComboBox SelectedIndex="{Binding Settings.HistoryRetention, Converter={StaticResource EnumInt}, ConverterParameter=HistoryRetention}">
                <ComboBoxItem Content="{Binding Loc[ret.day]}" />
                <ComboBoxItem Content="{Binding Loc[ret.week]}" />
                <ComboBoxItem Content="{Binding Loc[ret.month]}" />
                <ComboBoxItem Content="{Binding Loc[ret.3months]}" />
                <ComboBoxItem Content="{Binding Loc[ret.6months]}" />
                <ComboBoxItem Content="{Binding Loc[ret.year]}" />
                <ComboBoxItem Content="{Binding Loc[ret.forever]}" />
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="row-title" Text="{Binding Loc[row.clear.all]}" />
              <TextBlock Classes="row-hint" Text="{Binding Loc[hint.clear.all]}" />
              <Button Content="{Binding Loc[btn.clear.all]}" Classes="danger" HorizontalAlignment="Left"
                      Command="{Binding ClearAllHistoryCommand}" Padding="14,8" />
            </StackPanel>

            <TextBlock Text="{Binding AppVersionFull}" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />

            <Button Content="{Binding Loc[btn.reset]}"
                    Command="{Binding ResetDefaultsCommand}" HorizontalAlignment="Left" Padding="12,8" />
          </StackPanel>
        </Border>

        <!-- Permissions -->
        <TextBlock Classes="section-title" Text="{Binding Loc[sec.permissions]}" Margin="0,6,0,0" />
        <Border Classes="section-card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.accessibility]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.accessibility]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.PermissionAccessibility}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.screen]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.screen]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.PermissionScreenRecording}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Classes="row-title" Text="{Binding Loc[row.clipboard]}" />
                <TextBlock Classes="row-hint" Text="{Binding Loc[hint.clipboard]}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.PermissionClipboardRead}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Height="24" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
