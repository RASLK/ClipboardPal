<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClipboardPal</RootNamespace>
    <AssemblyName>ClipboardPal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>2.0.3</Version>
    <Product>ClipboardPal</Product>
    <Description>Cross-platform clipboard history for Windows, macOS and Linux</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="SharpHook" Version="5.3.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.7" />
    <PackageReference Include="System.Windows.Extensions" Version="9.0.7" />
    <!-- Offline OCR engine. Pulls SkiaSharp 3.x, which Avalonia 11.3 runs on fine.
         ExcludeAssets="build" drops the package's targets that would copy its own models next
         to the binary: ours are embedded in the assembly and also cover Cyrillic. -->
    <PackageReference Include="RapidOcrNet" Version="3.0.0" ExcludeAssets="build" />
  </ItemGroup>

  <!-- OCR models travel inside the assembly so a single-file build stays self-contained;
       they are unpacked next to the history on first use. -->
  <ItemGroup>
    <EmbeddedResource Include="OcrModels\*" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\ClipboardPal.Core\ClipboardPal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Self-contained single-file when publishing with -r <rid> (CI releases). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

</Project>
