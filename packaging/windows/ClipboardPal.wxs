<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 / v6 package for ClipboardPal single-file exe.
  Build:
    wix build ClipboardPal.wxs -arch x64|x86 \
      -d ProductVersion=2.0.0 \
      -d ExeSource=path\to\ClipboardPal.exe \
      -o ClipboardPal.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="ClipboardPal"
      Manufacturer="RASLK"
      Version="$(var.ProductVersion)"
      UpgradeCode="A7B3C9E1-4F2D-4A8B-9C1E-6D5F8A2B3C4D"
      Language="1033"
      Scope="perMachine">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of ClipboardPal is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="ProductFeature" Title="ClipboardPal" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <?if $(sys.BUILDARCH) = "x86" ?>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="ClipboardPal" />
    </StandardDirectory>
    <?else?>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClipboardPal" />
    </StandardDirectory>
    <?endif?>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ClipboardPal" />
    </StandardDirectory>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="ClipboardPalExe"
              Source="$(var.ExeSource)"
              Name="ClipboardPal.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="ClipboardPal"
                Description="Cross-platform clipboard history"
                Target="[INSTALLFOLDER]ClipboardPal.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\RASLK\ClipboardPal"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
